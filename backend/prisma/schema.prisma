enum EventCategory {
  APPOINTMENT
  MOVIE
  TV_SHOW
  GAME
  BIRTHDAY
  OTHER
  TODO
}

enum Recurrence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id        Int     @id @default(autoincrement())
  googleId  String? @unique
  email     String? @unique
  name      String?
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id                  Int           @id @default(autoincrement())
  // Nullable only during the authentication migration. It becomes required after legacy ownership is backfilled.
  userId              Int?
  user                User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category            EventCategory
  title               String
  // PostgreSQL DATE preserves a calendar date; it is not an instant in time.
  date                DateTime?     @db.Date
  startTime           DateTime?
  endTime             DateTime?
  description         String?
  details             Json?
  // Interoperability metadata used by iCalendar imports and exports.
  externalUid         String?
  timeZone            String?
  allDay              Boolean       @default(false)
  location            String?
  url                 String?
  recurrenceRule      String?
  status              String?
  sequence            Int?
  originalIcs         String?
  recurring           Recurrence?
  numberOfRecurrences Int?
  recurrenceEndDate   DateTime?                 @db.Date
  allowCompletion     Boolean       @default(false)
  completed           Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  occurrenceOverrides EventOccurrenceOverride[]
  recurrenceDates     EventRecurrenceDate[]
  exclusionDates      EventExclusionDate[]

  @@index([userId, category])
  @@index([userId, externalUid])
  @@index([date])
  @@index([startTime])
}

model EventRecurrenceDate {
  id      Int    @id @default(autoincrement())
  eventId Int
  // Preserves the original RFC 5545 value until recurrence expansion supports it.
  value   String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, value])
}

model EventExclusionDate {
  id      Int    @id @default(autoincrement())
  eventId Int
  // Preserves the original RFC 5545 value, including date-only and UTC forms.
  value   String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, value])
}

model EventOccurrenceOverride {
  id             Int      @id @default(autoincrement())
  eventId        Int
  occurrenceDate DateTime @db.Date
  date           DateTime? @db.Date
  description    String?
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceDate])
}

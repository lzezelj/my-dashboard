// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
enum EventType {
  APPOINTMENT
  MOVIE
  TV_SHOW
  GAME
  BIRTHDAY
  OTHER
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Todo{
  id Int @id @default(autoincrement())
  title String
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Event{
  id Int @id @default(autoincrement())
  title String
  description String?
  type EventType
  startDate DateTime
  allDay Boolean @default(false)
  endDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Movies{
  id Int @id @default(autoincrement())
  title String
  released DateTime
}
model TvShow{
  id Int @id @default(autoincrement())
  title String
  released DateTime
}
model Games{
  id Int @id @default(autoincrement())
  title String
  released DateTime
}
model Birthday{
  id Int @id @default(autoincrement())
  name String
  date DateTime
}